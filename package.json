{
  "name": "skip-the-bow",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run db:migrate && npm run db:seed && astro dev",
    "build": "npm run db:migrate && npm run db:seed && astro build",
    "preview": "netlify build && netlify serve",
    "astro": "astro",
    "test": "vitest run",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "check:lint": "eslint",
    "check:format": "prettier --check .",
    "check:astro": "astro check",
    "checks": "npm run check:format && npm run check:lint && npm run check:astro",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.3.4",
    "@astrojs/node": "^9.2.0",
    "@astrojs/react": "^4.3.0",
    "@auth/core": "^0.37.4",
    "@nanostores/react": "^1.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "astro": "^5.16.1",
    "auth-astro": "^4.2.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "nanostores": "^1.0.1",
    "pg": "^8.11.3",
    "postgres": "^3.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.15.2",
    "@types/pg": "^8.11.2",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "netlify-cli": "^22.1.3",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.1.1"
  },
  "overrides": {
    "esbuild": "^0.25.5"
  }
}
