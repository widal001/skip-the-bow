---
interface Props {
  type: "submit" | "button" | "link";
  variant: "primary" | "secondary" | "ghost" | "close";
  id?: string;
  href?: string;
  disabled?: boolean;
  class?: string;
}

const {
  type = "button",
  variant = "primary",
  href,
  disabled = false,
  class: className = "",
} = Astro.props;
---

{
  type === "link" ? (
    <a href={href} class={`button-${variant} ${className}`} id={Astro.props.id}>
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={`button-${variant} ${className}`}
      id={Astro.props.id}
      disabled={disabled}
    >
      <slot />
    </button>
  )
}
