---
interface Props {
  wishlists?: Array<{
    id: string;
    name: string;
    description?: string;
  }>;
}

const { wishlists = [] } = Astro.props;
---

<div class="wishlist-selector">
  <fieldset class="wishlist-selector__fieldset">
    <legend class="wishlist-selector__legend">Select Wishlists</legend>

    {
      wishlists.length > 0 ? (
        <div
          class="wishlist-selector__list"
          role="group"
          aria-labelledby="wishlist-selector-legend"
        >
          {wishlists.map((wishlist) => (
            <label
              class="wishlist-selector__item"
              for={`wishlist-${wishlist.id}`}
            >
              <input
                type="checkbox"
                id={`wishlist-${wishlist.id}`}
                name="wishlists"
                value={wishlist.id}
                class="wishlist-selector__checkbox"
                data-wishlist-id={wishlist.id}
              />
              <div class="wishlist-selector__content">
                <span class="wishlist-selector__name">{wishlist.name}</span>
                {wishlist.description && (
                  <span class="wishlist-selector__description">
                    {wishlist.description}
                  </span>
                )}
              </div>
            </label>
          ))}
        </div>
      ) : (
        <div class="wishlist-selector__empty">
          <p class="wishlist-selector__empty-text">
            No wishlists found. Create your first wishlist below.
          </p>
        </div>
      )
    }
  </fieldset>
</div>

<script>
  function initializeWishlistSelector() {
    const checkboxes = document.querySelectorAll(
      ".wishlist-selector__checkbox"
    ) as NodeListOf<HTMLInputElement>;
    const saveButton = document.getElementById(
      "wishlist-menu-save"
    ) as HTMLButtonElement;

    if (!checkboxes.length || !saveButton) {
      return;
    }

    // Function to update save button state
    function updateSaveButtonState() {
      const checkedBoxes = document.querySelectorAll(
        ".wishlist-selector__checkbox:checked"
      ) as NodeListOf<HTMLInputElement>;
      const hasCheckedBoxes = checkedBoxes.length > 0;

      if (saveButton) {
        saveButton.disabled = !hasCheckedBoxes;
      }
    }

    // Function to get selected wishlist IDs
    function getSelectedWishlistIds(): string[] {
      const checkedBoxes = document.querySelectorAll(
        ".wishlist-selector__checkbox:checked"
      ) as NodeListOf<HTMLInputElement>;
      return Array.from(checkedBoxes).map((checkbox) => checkbox.value);
    }

    // Add event listeners to checkboxes
    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", updateSaveButtonState);
    });

    // Initialize save button state
    updateSaveButtonState();

    // Expose functions globally for parent components
    (window as any).wishlistSelector = {
      getSelectedWishlistIds,
      updateSaveButtonState,
    };
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeWishlistSelector);
  } else {
    initializeWishlistSelector();
  }
</script>

<style>
  .wishlist-selector {
    margin-bottom: 1.5rem;
  }

  .wishlist-selector__fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .wishlist-selector__legend {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: 0.75rem;
    padding: 0;
  }

  .wishlist-selector__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .wishlist-selector__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--color-gray-200);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--color-white);
  }

  .wishlist-selector__item:hover {
    border-color: var(--color-gray-300);
    background: var(--color-gray-50);
  }

  .wishlist-selector__item:has(.wishlist-selector__checkbox:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .wishlist-selector__checkbox {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin: 0;
    cursor: pointer;
    accent-color: var(--color-primary);
  }

  .wishlist-selector__checkbox:focus {
    outline: none;
    box-shadow:
      0 0 0 2px var(--color-white),
      0 0 0 4px var(--color-primary);
  }

  .wishlist-selector__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .wishlist-selector__name {
    font-weight: 500;
    color: var(--color-gray-900);
    font-size: 0.875rem;
  }

  .wishlist-selector__description {
    font-size: 0.75rem;
    color: var(--color-gray-600);
    line-height: 1.4;
  }

  .wishlist-selector__empty {
    padding: 1rem;
    text-align: center;
    background: var(--color-gray-50);
    border: 1px dashed var(--color-gray-300);
    border-radius: 8px;
  }

  .wishlist-selector__empty-text {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-gray-600);
  }

  /* Focus styles for keyboard navigation */
  .wishlist-selector__item:focus-within {
    outline: none;
    box-shadow:
      0 0 0 2px var(--color-white),
      0 0 0 4px var(--color-primary);
  }
</style>
