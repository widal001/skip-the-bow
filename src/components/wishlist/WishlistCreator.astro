---
import Button from "@/components/Button.astro";

interface Props {
  showCreateForm?: boolean;
}

const { showCreateForm = false } = Astro.props;
---

<div class="wishlist-creator">
  <button
    type="button"
    class="wishlist-creator__toggle"
    id="wishlist-creator-toggle"
    aria-expanded="false"
    aria-controls="wishlist-creator-form"
  >
    <svg
      class="wishlist-creator__toggle-icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
    Create New Wishlist
  </button>

  <div
    class={`wishlist-creator__form-container ${showCreateForm ? "wishlist-creator__form-container--open" : ""}`}
    id="wishlist-creator-form"
    aria-hidden="true"
  >
    <form class="wishlist-creator__form" id="wishlist-creator-form-element">
      <div class="wishlist-creator__field">
        <label for="wishlist-name" class="wishlist-creator__label">
          Wishlist Name <span
            class="wishlist-creator__required"
            aria-label="required">*</span
          >
        </label>
        <input
          type="text"
          id="wishlist-name"
          name="wishlistName"
          class="wishlist-creator__input"
          placeholder="e.g., Birthday Wishlist"
          required
          maxlength="50"
        />
        <div class="wishlist-creator__help-text">
          Choose a descriptive name for your wishlist
        </div>
      </div>

      <div class="wishlist-creator__field">
        <label for="wishlist-description" class="wishlist-creator__label">
          Description <span class="wishlist-creator__optional">(optional)</span>
        </label>
        <textarea
          id="wishlist-description"
          name="wishlistDescription"
          class="wishlist-creator__textarea"
          placeholder="Add a description to help you remember what this wishlist is for..."
          rows="3"
          maxlength="255"></textarea>
        <div class="wishlist-creator__help-text">
          Optional description to help organize your wishlists
        </div>
      </div>

      <div class="wishlist-creator__actions">
        <Button type="button" variant="secondary" id="wishlist-creator-cancel">
          Cancel
        </Button>
        <Button type="submit" variant="primary" id="wishlist-creator-submit">
          Create Wishlist
        </Button>
      </div>
    </form>
  </div>
</div>

<script>
  import {
    wishlistActions,
    $wishlistCreatorStore,
  } from "@/lib/stores/wishlist/useWishlistStore";

  function initializeWishlistCreator() {
    const toggleButton = document.getElementById(
      "wishlist-creator-toggle"
    ) as HTMLButtonElement;
    const formContainer = document.getElementById(
      "wishlist-creator-form"
    ) as HTMLElement;
    const form = document.getElementById(
      "wishlist-creator-form-element"
    ) as HTMLFormElement;
    const cancelButton = document.getElementById(
      "wishlist-creator-cancel"
    ) as HTMLButtonElement;
    const nameInput = document.getElementById(
      "wishlist-name"
    ) as HTMLInputElement;
    const descriptionInput = document.getElementById(
      "wishlist-description"
    ) as HTMLTextAreaElement;

    if (!toggleButton || !formContainer || !form || !cancelButton) {
      console.error("Wishlist creator elements not found");
      return;
    }

    // Subscribe to store changes to update UI
    $wishlistCreatorStore.subscribe((state) => {
      // Update form visibility
      const isFormOpen = state.isFormOpen;
      toggleButton.setAttribute("aria-expanded", isFormOpen.toString());
      formContainer.setAttribute("aria-hidden", (!isFormOpen).toString());

      if (isFormOpen) {
        formContainer.classList.add("wishlist-creator__form-container--open");
        // Focus the name input when opening
        setTimeout(() => {
          nameInput?.focus();
        }, 100);
      } else {
        formContainer.classList.remove(
          "wishlist-creator__form-container--open"
        );
        // Reset form when closing
        form.reset();
        // Move focus back to toggle button to avoid accessibility issues
        toggleButton.focus();
      }

      // Show/hide error state
      if (state.error) {
        // You could add error display logic here
        console.error("Form error:", state.error);
      }

      // Handle loading state
      if (state.isLoading) {
        const submitButton = document.getElementById(
          "wishlist-creator-submit"
        ) as HTMLButtonElement;
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = "Creating...";
        }
      } else {
        const submitButton = document.getElementById(
          "wishlist-creator-submit"
        ) as HTMLButtonElement;
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Create Wishlist";
        }
      }
    });

    // Toggle form visibility
    function toggleForm() {
      const currentState = $wishlistCreatorStore.get();
      if (currentState.isFormOpen) {
        wishlistActions.cancelCreateForm();
      } else {
        wishlistActions.startCreateForm();
      }
    }

    // Close form
    function closeForm() {
      wishlistActions.cancelCreateForm();
    }

    // Handle form submission
    async function handleFormSubmit(e: Event) {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get("wishlistName") as string;
      const description = formData.get("wishlistDescription") as string;

      // Update form data in store and submit
      wishlistActions.updateFormData({
        name: name.trim(),
        description: description.trim(),
      });

      // Submit the form
      const success = await wishlistActions.submitCreateForm();

      if (success) {
        // Form will be closed automatically on success
        console.log("Wishlist created successfully");
      }
    }

    // Event listeners
    toggleButton.addEventListener("click", toggleForm);
    cancelButton.addEventListener("click", closeForm);
    form.addEventListener("submit", handleFormSubmit);

    // Keyboard navigation
    toggleButton.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        toggleForm();
      }
    });

    // Character counter for textarea
    if (descriptionInput) {
      descriptionInput.addEventListener("input", () => {
        const maxLength = 255;
        const currentLength = descriptionInput.value.length;
        const helpText = descriptionInput.parentElement?.querySelector(
          ".wishlist-creator__help-text"
        );

        if (helpText) {
          helpText.textContent = `${currentLength}/${maxLength} characters`;
        }
      });
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeWishlistCreator);
  } else {
    initializeWishlistCreator();
  }
</script>

<style>
  .wishlist-creator__toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-gray-300);
    background: var(--color-white);
    color: var(--color-gray-700);
    border-radius: 8px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .wishlist-creator__toggle:hover {
    background: var(--color-gray-50);
    border-color: var(--color-gray-400);
  }

  .wishlist-creator__toggle:focus {
    outline: none;
    box-shadow:
      0 0 0 2px var(--color-white),
      0 0 0 4px var(--color-primary);
  }

  .wishlist-creator__toggle-icon {
    transition: transform 0.2s ease;
  }

  .wishlist-creator__toggle[aria-expanded="true"]
    .wishlist-creator__toggle-icon {
    transform: rotate(45deg);
  }

  .wishlist-creator__form-container {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .wishlist-creator__form-container--open {
    max-height: 500px;
    margin-top: 1rem;
  }

  .wishlist-creator__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .wishlist-creator__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .wishlist-creator__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-900);
  }

  .wishlist-creator__required {
    color: var(--color-red-500);
  }

  .wishlist-creator__optional {
    color: var(--color-gray-500);
    font-weight: 400;
  }

  .wishlist-creator__input,
  .wishlist-creator__textarea {
    padding: 0.75rem;
    border: 1px solid var(--color-gray-300);
    border-radius: 6px;
    font-size: 0.875rem;
    font-family: inherit;
    transition: all 0.2s ease;
    resize: vertical;
  }

  .wishlist-creator__input:focus,
  .wishlist-creator__textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .wishlist-creator__textarea {
    min-height: 80px;
  }

  .wishlist-creator__help-text {
    font-size: 0.75rem;
    color: var(--color-gray-600);
  }

  .wishlist-creator__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }
</style>
